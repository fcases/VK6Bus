            n_written += buffer.encode_int32 (this.ReceiveBuffer);
            n_written += buffer.encode_varint (32);
        }
        for (unowned List<EndPointDef> i = this.EndPoint.last (); i != null; i = i.prev)
        {
            var EndPoint_length = i.data.encode (buffer);
            n_written += EndPoint_length;
            n_written += buffer.encode_varint (EndPoint_length);
            n_written += buffer.encode_varint (26);
        }
        n_written += buffer.encode_int32 (this.Port);
        n_written += buffer.encode_varint (16);
        var LocalAddress_length = buffer.encode_string (this.LocalAddress);
        n_written += LocalAddress_length;
        n_written += buffer.encode_varint (LocalAddress_length);
        n_written += buffer.encode_varint (10);

        return n_written;
    }

    public override string to_string (string indent = "")
    {
        var text = "";

        text += indent + "LocalAddress: %s\n".printf (Protobuf.string_to_string (this.LocalAddress));
        text += indent + "Port: %s\n".printf (this.Port.to_string ());
        foreach (unowned EndPointDef v in this.EndPoint)
        {
            text += indent + "EndPoint {\n";
            text += "%s".printf (v.to_string (indent + "  "));
            text += indent + "}\n";
        }
        text += indent + "ReceiveBuffer: %s\n".printf (this.ReceiveBuffer.to_string ());
        text += indent + "SendBuffer: %s\n".printf (this.SendBuffer.to_string ());

        return text;
    }
}

public class EndPointDef : Protobuf.Message
{
    public string Host;
    public int32 Port;

    public EndPointDef ()
    {
        this.Host = "";
        this.Port = 40069;
    }

    public EndPointDef.from_data (Protobuf.DecodeBuffer buffer, ssize_t data_length = -1)
    {
        decode (buffer, data_length);
    }

    public override bool decode (Protobuf.DecodeBuffer buffer, ssize_t data_length = -1)
    {
        size_t end;
        if (data_length < 0)
            end = buffer.buffer.length;
        else
            end = buffer.read_index + data_length;
        var have_Host = false;
        var have_Port = false;

        this.Host = "";
        this.Port = 40069;
        while (buffer.read_index < end)
        {
            var key = buffer.decode_varint ();
            var wire_type = key & 0x7;
            var field_number = key >> 3;

            if (field_number == 1 && wire_type == 2)
            {
                this.Host = buffer.decode_string ((size_t) buffer.decode_varint ());
                have_Host = true;
            }
            else if (field_number == 2 && wire_type == 0)
            {
                this.Port = buffer.decode_int32 ();
                have_Port = true;
            }
            else
                this.unknown_fields.prepend (buffer.decode_unknown_field (key));
        }

        if (buffer.read_index != end)
            buffer.error = true;
        else if (!have_Host || !have_Port)
            buffer.error = true;

        return !buffer.error;
    }

    public override size_t encode (Protobuf.EncodeBuffer buffer)
    {
        size_t n_written = 0;

        foreach (var f in this.unknown_fields)
            n_written += buffer.encode_unknown_field (f);
        n_written += buffer.encode_int32 (this.Port);
        n_written += buffer.encode_varint (16);
        var Host_length = buffer.encode_string (this.Host);
        n_written += Host_length;
        n_written += buffer.encode_varint (Host_length);
        n_written += buffer.encode_varint (10);

        return n_written;
    }

    public override string to_string (string indent = "")
    {
        var text = "";

        text += indent + "Host: %s\n".printf (Protobuf.string_to_string (this.Host));
        text += indent + "Port: %s\n".printf (this.Port.to_string ());

        return text;
    }
}

public class CrossConnectorDef : Protobuf.Message
{
    public List<string> Transport;

    public CrossConnectorDef ()
    {
        this.Transport = new List<string> ();
    }

    public CrossConnectorDef.from_data (Protobuf.DecodeBuffer buffer, ssize_t data_length = -1)
    {
        decode (buffer, data_length);
    }

    public override bool decode (Protobuf.DecodeBuffer buffer, ssize_t data_length = -1)
    {
        size_t end;
        if (data_length < 0)
            end = buffer.buffer.length;
        else
            end = buffer.read_index + data_length;

        this.Transport = new List<string> ();
        while (buffer.read_index < end)
        {
            var key = buffer.decode_varint ();
            var wire_type = key & 0x7;
            var field_number = key >> 3;

            if (field_number == 1 && wire_type == 2)
                this.Transport.append (buffer.decode_string ((size_t) buffer.decode_varint ()));
            else
                this.unknown_fields.prepend (buffer.decode_unknown_field (key));
        }

        if (buffer.read_index != end)
            buffer.error = true;

        return !buffer.error;
    }

    public override size_t encode (Protobuf.EncodeBuffer buffer)
    {
        size_t n_written = 0;

        foreach (var f in this.unknown_fields)
            n_written += buffer.encode_unknown_field (f);
        for (unowned List<string> i = this.Transport.last (); i != null; i = i.prev)
        {
            var Transport_length = buffer.encode_string (i.data);
            n_written += Transport_length;
            n_written += buffer.encode_varint (Transport_length);
            n_written += buffer.encode_varint (10);
        }

        return n_written;
    }

    public override string to_string (string indent = "")
    {
        var text = "";

        foreach (unowned string v in this.Transport)
        {
            text += indent + "Transport: %s\n".printf (Protobuf.string_to_string (v));
        }

        return text;
    }
}
